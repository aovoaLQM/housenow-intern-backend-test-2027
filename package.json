    "test": "vitest run tests/public",
    "test:public": "vitest run tests/public",
    "test:watch": "vitest tests/public",
    "test:smoke": "vitest run tests/smoke"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "better-sqlite3": "^11.8.1",
    "kysely": "0.29.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tanstack/router-cli": "1.167.21",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
