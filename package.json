{
  "name": "housenow-intern-backend-test-2027",
  "version": "1.0.0",
  "private": true,
  "description": "HouseNow Backend Intern mini test with TanStack Start, TanStack Router and Kysely",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "start": "vite preview",
    "generate-routes": "tsr generate",
